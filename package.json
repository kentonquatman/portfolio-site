{"author":"","description":"A simple UX design portfolio built with 11ty and Sass.","devDependencies":{"@11ty/eleventy":"^3.1.6","sass":"^1.104.1"},"keywords":[],"license":"ISC","name":"portfolio","scripts":{"build":"npm run build:site && npm run build:css","build:css":"sass src/scss/main.scss _site/css/main.css --style=compressed --no-source-map","build:site":"eleventy","start":"eleventy --serve","watch:css":"sass --watch src/scss/main.scss:_site/css/main.css --style=compressed --no-source-map"},"version":"1.0.0"}