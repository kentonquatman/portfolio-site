---
layout: layouts/base.njk
title: Home
---
<section class="hero">
  <div class="container">
    <p class="kicker">{{ site.role }}</p>
    <h1 class="hero__title">Hi, I'm {{ site.name }}.</h1>
    <p class="hero__lede">{{ site.tagline }}</p>
    <div class="hero__actions">
      <a class="button" href="{{ '/work/' | url }}">View my work</a>
      <a class="button button--secondary" href="{{ '/contact/' | url }}">Get in touch</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section__head">
      <h2 class="section__title">Selected work</h2>
      <a class="section__link" href="{{ '/work/' | url }}">All projects →</a>
    </div>
    <div class="card-grid">
      {%- for project in collections.projects -%}
        {% include "partials/project-card.njk" %}
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container container--narrow about-teaser">
    <h2 class="section__title">A little about me</h2>
    <p>A short paragraph about who you are, what you care about, and how you like to work goes here.</p>
    <a class="button button--secondary" href="{{ '/about/' | url }}">More about me</a>
  </div>
</section>
