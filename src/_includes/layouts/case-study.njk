---
layout: layouts/base.njk
---
<article class="case-study">
  <div class="container container--narrow">
    <header class="case-study__header">
      <p class="kicker">Case study</p>
      <h1>{{ title }}</h1>
      <p class="lede">{{ summary }}</p>
      <dl class="meta-list">
        <div class="meta-list__item">
          <dt>Role</dt>
          <dd>{{ role }}</dd>
        </div>
        <div class="meta-list__item">
          <dt>Timeline</dt>
          <dd>{{ timeline }}</dd>
        </div>
        <div class="meta-list__item">
          <dt>Team</dt>
          <dd>{{ team }}</dd>
        </div>
      </dl>
    </header>
    <div class="prose">
      {{ content | safe }}
    </div>
    <nav class="case-study__footer">
      <a href="{{ '/work/' | url }}">← All projects</a>
    </nav>
  </div>
</article>
