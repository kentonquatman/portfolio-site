<article class="card">
  <a class="card__link" href="{{ project.url | url }}">
    <div class="card__thumb" aria-hidden="true">
      <span>{{ project.data.title | first }}</span>
    </div>
    <div class="card__body">
      <h3 class="card__title">{{ project.data.title }}</h3>
      <p class="card__summary">{{ project.data.summary }}</p>
      <p class="card__meta">{{ project.data.role }} · {{ project.data.timeline }}</p>
    </div>
  </a>
</article>
