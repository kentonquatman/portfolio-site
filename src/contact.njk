---
layout: layouts/base.njk
title: Contact
---
<section class="section">
  <div class="container container--narrow contact">
    <p class="kicker">Contact</p>
    <h1 class="page-title">Let's work together.</h1>
    <p class="lede">I'm currently open to new opportunities and freelance projects. The fastest way to reach me is by email.</p>
    <div class="contact__actions">
      <a class="button" href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
    <h2 class="section__title">Elsewhere</h2>
    <ul class="link-list">
      {% for link in site.social %}
      <li><a href="{{ link.url }}" rel="noopener">{{ link.label }} →</a></li>
      {% endfor %}
    </ul>
  </div>
</section>
